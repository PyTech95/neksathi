<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Call setup"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable these so an incoming call rings on your lock screen, like a normal phone call."
            android:textColor="#B6B6C6"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp" />

        <!-- Notifications -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#15151F"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Notifications"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status_notif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not enabled — tap Enable"
                android:textColor="#E11D48"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btn_notif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:backgroundTint="#E92546"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Full-screen notifications (Android 14+) -->
        <LinearLayout
            android:id="@+id/row_fullscreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#15151F"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Full-screen calls"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status_fullscreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not enabled — tap Enable"
                android:textColor="#E11D48"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btn_fullscreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:backgroundTint="#E92546"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Display over other apps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#15151F"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Display over other apps"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status_overlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not enabled — tap Enable"
                android:textColor="#E11D48"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btn_overlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:backgroundTint="#E92546"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Battery optimisation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#15151F"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. Battery — don't restrict"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not enabled — tap Enable"
                android:textColor="#E11D48"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btn_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:backgroundTint="#E92546"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Auto-start (OEM-specific) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#15151F"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5. Auto-start"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="On Xiaomi / Oppo / Vivo / Samsung etc., allow the app to auto-start so calls arrive when the app is closed."
                android:textColor="#B6B6C6"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btn_autostart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open settings"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:backgroundTint="#E92546"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_done"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Done"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#16A34A"
            android:layout_marginBottom="20dp" />
    </LinearLayout>
</ScrollView>
